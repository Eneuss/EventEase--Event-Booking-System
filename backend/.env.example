# Copy to .env and adjust. npm start loads .env automatically if it exists.

# Secret used to sign session cookies. Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" to require a real SESSION_SECRET.
NODE_ENV=development

# Port the API listens on.
PORT=3000

# SQLite file, relative to the backend folder. Created and seeded on first start.
DB_PATH=data/eventease.db
